{
  "expo": {
    "name": "HeyYallNativeExpo",
    "slug": "HeyYallNativeExpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icons/yall_logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./app/assets/icons/yall_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#003256"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scorpus.HeyYallNativeExpo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#003256"
      },
      "package": "com.scorpus.HeyYallNativeExpo"
    },
    "web": {
      "bundler": "webpack",
      "output": "static"
    },
    "plugins": [
      "expo-font"
    ]
  }
}